{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DVM",
  "version": "1.43.0",
  "identifier": "jp.demo2.dvm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:mcp && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DVM",
        "width": 1600,
        "height": 950,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/thumbs/**", "**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "demodemo",
    "homepage": "https://github.com/demodemo0818/dvm",
    "copyright": "Copyright (C) 2026 demodemo",
    "license": "GPL-3.0-or-later",
    "category": "Video",
    "shortDescription": "動画をコピーせずに整理する Windows 向け動画管理ソフト",
    "longDescription": "動画ファイルを元の場所に置いたまま、サムネイル・タグ・シリーズ・評価で整理します。外付け HDD や NAS の大量の動画をそのまま扱え、libmpv によるアプリ内再生と MCP / AI アシスタントからの操作に対応しています。",
    "resources": [
      "binaries/ffmpeg.exe",
      "binaries/ffprobe.exe",
      "binaries/dvm-mcp.exe",
      "lib/**/*",
      "resources/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
